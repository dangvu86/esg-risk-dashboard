[Unit]
Description=ESG collector — enqueue yesterday's window (daily oneshot)

[Service]
Type=oneshot
User=esg
Group=esg
WorkingDirectory=/opt/esg-collector/esg-collector
EnvironmentFile=/etc/esg-collector.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/esg-collector/.venv/bin/python -m core.queue_builder --mode daily
StandardOutput=append:/var/log/esg-collector/daily.log
StandardError=append:/var/log/esg-collector/daily.log
