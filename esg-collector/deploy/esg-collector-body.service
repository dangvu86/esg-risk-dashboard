[Unit]
Description=ESG collector — Jina body fetcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=esg
Group=esg
WorkingDirectory=/opt/esg-collector/esg-collector
EnvironmentFile=/etc/esg-collector.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/esg-collector/.venv/bin/python -m workers.body_fetcher --workers 8
Restart=always
RestartSec=30
StandardOutput=append:/var/log/esg-collector/body.log
StandardError=append:/var/log/esg-collector/body.log

[Install]
WantedBy=multi-user.target
