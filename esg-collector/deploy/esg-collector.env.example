# Copy to /etc/esg-collector.env on the GCE VM, then `chmod 600` + chown to the runtime user.
# Both keys are loaded by config/settings.py via os.environ.

BRAVE_API_KEY=
JINA_API_KEY=

# Optional: tune throttle without editing settings.py.
# Defaults in code: google_rss=25s, baomoi=15s, brave=1s.
# ESG_THROTTLE_GOOGLE_RSS=25
# ESG_THROTTLE_BAOMOI=15
# ESG_THROTTLE_BRAVE=1
