[Unit]
Description=ESG collector — match + export (oneshot, triggered by .timer)

[Service]
Type=oneshot
User=esg
Group=esg
WorkingDirectory=/opt/esg-collector/esg-collector
EnvironmentFile=/etc/esg-collector.env
Environment=PYTHONUNBUFFERED=1
# Resource caps for the 1GB/0.25-vCPU e2-micro: a runaway match (huge 'pending'
# backlog) gets cgroup-OOM-killed — only this unit dies — instead of the kernel
# OOM-killer wedging the whole VM (sshd/guest-agent). Throttle keeps it SSH-responsive.
MemoryHigh=350M
MemoryMax=450M
CPUQuota=50%
Nice=15
IOSchedulingClass=idle
ExecStart=/opt/esg-collector/.venv/bin/python -m pipeline.match
ExecStart=/opt/esg-collector/.venv/bin/python -m pipeline.export --ndjson --upload
StandardOutput=append:/var/log/esg-collector/match.log
StandardError=append:/var/log/esg-collector/match.log
